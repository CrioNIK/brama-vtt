      {
        "code": "global-light-configuration",
        "path": "/environment/globalLight",
        "message": "Configured enabled flag and native metadata retained; darkness thresholds, shaders and level-specific activation are not evaluated by the bridge."
      },
      {
        "code": "coordinate-frame",
        "path": "",
        "message": "Foundry document coordinates retained. Padding, shift, background transforms and hex measurement rules are not applied."
      },
      {
        "code": "level-rendering",
        "path": "/levels",
        "message": "Level IDs, names, elevation boundaries and native texture/visibility metadata are extracted. Entity level IDs are copied when present. No flattening, transform evaluation, occlusion, asset fetching or inferred membership is performed."
      },
      {
        "code": "light-rendering",
        "path": "/lights/0",
        "message": "Dim/bright radii converted using grid distance. Cone, rotation, attenuation, animation, darkness, elevation and wall interaction remain source-only."
      },
      {
        "code": "token-delta-source-only",
        "path": "/tokens/0/delta",
        "message": "Only supported dnd5e source HP overrides may be merged; delta effects, items, permissions and all other behavior remain source-only."
      },
      {
        "code": "token-hp-base-delta",
        "path": "/tokens/0/delta/system/attributes/hp",
        "message": "Independent dnd5e 6.0.6 source HP = supplied Actor fields overridden only by present native delta HP leaves. Missing leaves inherit; Effects/formulas are not evaluated."
      },
      {
        "code": "unlinked-token-resources",
        "path": "/tokens/0",
        "message": "actorId is identity only. actorLink=false means an independent HP snapshot; later Actor changes must not update this token. hp=null means unresolved resource state."
      },
      {
        "code": "token-rendering",
        "path": "/tokens/0",
        "message": "Center = top-left + grid size * cell dimensions / 2. Texture anchor/shape, elevation physics, animation, display modes and rotation artwork are not rendered; native metadata remains inert."
      },
      {
        "code": "token-sight-semantics",
        "path": "/tokens/0/sight",
        "message": "Normalized rangePixels describes sight WITHOUT a light source; null means native unlimited. Whole sight=null means unknown configuration. Range 0 is not blind or infinite. Light perception, mode, detection and occlusion require a compatible consumer."
      },
      {
        "code": "token-bars-source-metadata",
        "path": "/tokens/0",
        "message": "Bar bindings/display modes are retained as metadata. Only explicitly supported Actor/local HP is normalized; other resources need a system adapter."
      },
      {
        "code": "token-permissions-reset",
        "path": "/tokens/0",
        "message": "Import policy is GM-only. Source user IDs, disposition and visibility never grant destination ownership."
      },
      {
        "code": "source-only-fields",
        "path": "",
